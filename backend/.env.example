# DecideFast Environment Configuration

# 1. TypeSafe Jev API Key (System One Sub-Second Primitives)
# Get your key at https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_MODEL=jev-1.13.0

# 2. System Two LLM Synthesis (Optional - defaults to zero-cost local synthesis)
# Google AI Studio Free Tier Key (Recommended for free cloud LLM): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Alternative): https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GCP Vertex AI Cloud Billing (Keep false to avoid unexpected cloud charges)
USE_VERTEX_OAUTH=false
GCP_PROJECT=
GCP_LOCATION=us-central1

# 3. Default Copilot Personality (ruthless | diplomatic)
PERSONALITY=ruthless
